# CORS headers for cross-origin requests
/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Allow-Headers: Content-Type

# Cache control for static assets
/images/*
  Cache-Control: public, max-age=31536000, immutable

# OG images are unhashed and may be re-rendered when titles/summaries change.
# 24h TTL with must-revalidate so crawlers and previews pick up updates within a day.
/images/og/*
  Cache-Control: public, max-age=86400, must-revalidate

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/videos/*
  Cache-Control: public, max-age=31536000, immutable

# Audio media (mp3 / opus / ambient.opus) keep stable filenames but carry a
# content-hash query string in the manifest (?v=<hash>). A re-render changes
# that query string, so the URL is a fresh cache key — the file itself can
# safely stay immutable. See update_book_manifest() in generate_audio.py.
/audio/*
  Cache-Control: public, max-age=31536000, immutable

# Manifests and timing sidecars keep stable, unhashed names and are
# regenerated on every render, so they must NOT be cached immutably or
# playback drifts out of sync with re-rendered audio. Always revalidate
# (cheap ETag 304s — these files are tiny). Declared after /audio/* so it
# wins the Cache-Control conflict for .json files (later + more specific).
/audio/*.json
  Cache-Control: public, max-age=0, must-revalidate

/downloads/*
  Cache-Control: public, max-age=3600
